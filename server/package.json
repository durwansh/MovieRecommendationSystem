{
  "name": "ai-movie-recommendation-server",
  "version": "1.0.0",
  "description": "Backend API for AI-Powered Movie Recommendation System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seedData.js",
    "seed:1m": "node utils/seed1MTmdb.js",
    "seed:download": "node utils/downloadDataset.js",
    "ml:train": "python -m ml_pipeline.train",
    "ml:eval": "python -m ml_pipeline.evaluate",
    "ml:serve": "python -m uvicorn ml_pipeline.service:app --port 8000"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
